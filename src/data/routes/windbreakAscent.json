    {
      "id": "highlands-cairn",
      "weight": 100,
      "triggerBeforeEncounter": 3,
      "eyebrow": "高地見聞",
      "title": "被風吹歪的路標",
      "transitionText": [
        "山路在前方轉了一個彎……",
        "被風吹歪的路標出現在背風處。"
      ],
      "narrative": [
        "一座石塔倒在岔路旁。底石上還留著前人刻下的痕跡。",
        "重新堆好石塔需要力氣，卻也能讀懂藏在風裡的方向。"
      ],
      "prompt": "你打算怎麼做？",
      "choices": [
        {
          "id": "read",
          "meta": "損失 12 生命，取得額外祝福三選一。；下一場雙岩全毀",
          "title": "扶正石塔",
          "description": "你把倒下的石塊重新堆回路口。",
          "action": "選擇",
          "result": {
            "narrative": [
              "你把倒下的石塊重新堆回路口。",
              "山風仍在。你收好物品，沿著路標指向的方向繼續前進。",
              "你移開了擋風的殘岩。下一場將沒有遮蔽，這條缺口會由你自己承擔。"
            ],
            "effects": [
              {
                "type": "loseHp",
                "amount": 12
              },
              {
                "type": "highlandTerrain",
                "mode": "exposed"
              }
            ],
            "defaultTarget": {
              "type": "chooseBlessing",
              "poolId": "highlands",
              "count": 3
            },
            "resultIds": [
              "cairn-read"
            ],
            "continueLabel": "繼續攀登"
          }
        },
        {
          "id": "rest",
          "meta": "恢復最大生命 12%，不取得祝福。",
          "title": "靠岩休息",
          "description": "你靠著岩背坐下，慢慢調整呼吸。",
          "action": "選擇",
          "result": {
            "narrative": [
              "你靠著岩背坐下，慢慢調整呼吸。",
              "山風仍在。你收好物品，沿著路標指向的方向繼續前進。"
            ],
            "effects": [
              {
                "type": "recoverHp",
                "maxHpRatio": 0.12
              }
            ],
            "defaultTarget": {
              "type": "returnAdventure"
            },
            "resultIds": [
              "cairn-rest"
            ],
            "continueLabel": "繼續攀登"
          }
        }
      ]
    },
    {
